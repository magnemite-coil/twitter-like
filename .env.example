# アプリケーション設定
APP_ENV=development
APP_PORT=8080

# データベース設定（PostgreSQL）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=twitter_like
DB_USER=postgres
DB_PASSWORD=postgres

# Redis設定
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# セキュリティ設定
SESSION_SECRET=change-this-to-random-256-bit-hex-string
CSRF_SECRET=change-this-to-random-256-bit-hex-string

# CORS設定（開発環境のみ）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ログ設定
LOG_LEVEL=info
LOG_FILE=var/log/app.log
